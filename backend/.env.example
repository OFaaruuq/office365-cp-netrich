# netrichtechnologies CSP API — copy to .env (never commit secrets)
# Runbook: backend/README.md · Architecture: docs/CSP_PRODUCTION_ARCHITECTURE.md

DATABASE_URL=postgresql://netrich:netrich_dev@localhost:5432/netrich_csp?schema=public
REDIS_URL=redis://localhost:6379
PORT=8080
NODE_ENV=development

# Identity — Next session HMAC must match Nest PORTAL_SESSION_SECRET
PORTAL_SESSION_SECRET=
CSP_INTERNAL_API_SECRET=

# Entra ID — access token validation for /v1/auth/*
AZURE_AD_TENANT_ID=common
AZURE_AD_API_AUDIENCE=
AZURE_AD_SPA_CLIENT_ID=

# Graph (Phase 2 live sync)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_ACCESS_TOKEN=

# Partner Center read-only (writes stay off unless PARTNER_CENTER_WRITES_ENABLED=true)
PARTNER_CENTER_APP_ID=
PARTNER_CENTER_APP_SECRET=
PARTNER_CENTER_TENANT_ID=
PARTNER_CENTER_WRITES_ENABLED=false

# Secure Application Model / Key Vault
AZURE_KEY_VAULT_URI=
PARTNER_CERT_NAME=partner-center-cert
TOKEN_ENCRYPTION_KEY_NAME=token-encryption-key
PARTNER_CENTER_MODE=sandbox

# Webhooks (signed ingress)
WEBHOOK_SECRET=
WEBHOOK_CLIENT_STATE=

# CORS — Next.js UI
CORS_ORIGINS=http://localhost:3000
