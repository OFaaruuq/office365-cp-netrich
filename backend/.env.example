# netrichtechnologies CSP API — copy to .env (never commit secrets)
# Runbook: backend/README.md · Architecture: docs/CSP_PRODUCTION_ARCHITECTURE.md

DATABASE_URL=postgresql://netrich:netrich_dev@localhost:5432/netrich_csp?schema=public
REDIS_URL=redis://localhost:6379
PORT=8080
NODE_ENV=development

# Entra ID — access token validation for /v1/auth/*
AZURE_AD_TENANT_ID=common
AZURE_AD_API_AUDIENCE=
AZURE_AD_SPA_CLIENT_ID=

# Secure Application Model / Key Vault (Phase 1 status stubs only — no PC writes)
AZURE_KEY_VAULT_URI=
PARTNER_CERT_NAME=partner-center-cert
TOKEN_ENCRYPTION_KEY_NAME=token-encryption-key
PARTNER_CENTER_MODE=sandbox

# CORS — Next.js UI
CORS_ORIGINS=http://localhost:3000
