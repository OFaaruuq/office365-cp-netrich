# =============================================================================
# Production — NestJS CSP API + worker (native host, no Docker)
# Copy to backend/.env  (never commit secrets)
# Full runbook: docs/DEPLOYMENT.md
# =============================================================================

NODE_ENV=production
PORT=8080

# PostgreSQL 16 on this host (non-superuser). URL-encode special chars in the password.
DATABASE_URL=postgresql://netrich:CHANGE_ME@127.0.0.1:5432/netrich_csp?schema=public

# Redis 7 / Memurai on this host
REDIS_URL=redis://127.0.0.1:6379

# Must match the Next.js .env.production values exactly
PORTAL_SESSION_SECRET=
CSP_INTERNAL_API_SECRET=

# Browser origin only — Nest is not public
CORS_ORIGINS=https://office365.cp.netrichtechnologies.com

# Entra (validation / Graph tenant hint)
AZURE_AD_TENANT_ID=
AZURE_AD_API_AUDIENCE=
AZURE_AD_SPA_CLIENT_ID=

# Graph app-only (Phase 2). Do not set GRAPH_ACCESS_TOKEN in production.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=

# Partner Center read-only until writes are explicitly enabled
PARTNER_CENTER_APP_ID=
PARTNER_CENTER_APP_SECRET=
PARTNER_CENTER_TENANT_ID=
PARTNER_CENTER_MODE=sandbox
PARTNER_CENTER_WRITES_ENABLED=false

# Secure Application Model / Key Vault (optional)
AZURE_KEY_VAULT_URI=
PARTNER_CERT_NAME=partner-center-cert
TOKEN_ENCRYPTION_KEY_NAME=token-encryption-key

# Signed webhook ingress
WEBHOOK_SECRET=
WEBHOOK_CLIENT_STATE=
