# netrichtechnologies — Microsoft 365 Control Panel
# Domain: https://office365.cp.netrichtechnologies.com
# Docs: README.md · docs/DOCUMENTATION.md · docs/CSP_PRODUCTION_ARCHITECTURE.md

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=office365.cp.netrichtechnologies.com

# Azure AD / Entra ID App Registration (CSP / Partner tenant) — production SSO
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_AUTHORITY=https://login.microsoftonline.com/common
# Or: https://login.microsoftonline.com/<tenant-id>

# NestJS CSP API (Phase 1 Foundation) — see backend/.env.example
NEXT_PUBLIC_CSP_API_URL=http://localhost:8080
CSP_API_URL=http://localhost:8080

# Server-side placeholders (prefer Key Vault / certificates in production — SAM)
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
PARTNER_CENTER_APP_ID=
PARTNER_CENTER_ACCOUNT_ID=

# Hard tenant isolation — HMAC secret for httpOnly portal session cookies
# REQUIRED in production (long random string, ≥32 chars)
PORTAL_SESSION_SECRET=

# Demo email/password login (local/dev). Public page never lists tenants.
# Production identity is Microsoft Entra SSO — demo TOTP is NOT primary MFA for Microsoft admins.
# DEMO_LOGIN_PASSWORD=demo
# ALLOW_DEMO_LOGIN=true
ALLOW_DEMO_LOGIN=
DEMO_LOGIN_PASSWORD=
