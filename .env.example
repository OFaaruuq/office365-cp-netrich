# =============================================================================
# netrichtechnologies — Microsoft 365 Control Panel (Next.js UI)
# Domain: https://office365.cp.netrichtechnologies.com
# Docs: README.md · docs/DEPLOYMENT.md · docs/DOCUMENTATION.md
#
# Local:   copy to .env.local   →  npm run dev
# Prod:    copy to .env.production (see .env.production.example) → docs/DEPLOYMENT.md (native, no Docker)
# Backend: see backend/.env.example (NestJS / Postgres / Redis)
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=office365.cp.netrichtechnologies.com
# PORT=3000
# HOSTNAME=0.0.0.0

# --- Microsoft Entra ID (required for production SSO) ---
# App registration in the partner / CSP tenant.
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_AUTHORITY=https://login.microsoftonline.com/common
# Or pin a tenant: https://login.microsoftonline.com/<tenant-id>
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# API audience for JWT verification (api://app-id or Graph).
AZURE_AD_API_AUDIENCE=

# --- NestJS CSP API (Phase 1 Foundation) ---
# Optional. If unreachable, /api/csp/* falls back to local .data SoR.
NEXT_PUBLIC_CSP_API_URL=http://localhost:8080
CSP_API_URL=http://localhost:8080
CSP_INTERNAL_API_SECRET=

# --- Session (hard tenant isolation) ---
# HMAC secret for httpOnly portal session cookies.
# REQUIRED in production (≥32 random chars). Generate: npm run deploy:secret
PORTAL_SESSION_SECRET=
# Alias accepted by the server if PORTAL_SESSION_SECRET is unset:
# SESSION_SECRET=

# --- Emergency access (break-glass emails only; unique password + TOTP) ---
# Everyday sign-in is Microsoft Entra ID. Do not enable a shared password.
PORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@netrichtechnologies.com

# Trust X-Forwarded-For for rate limits (set true behind a reverse proxy).
# TRUST_PROXY=true

# --- Partner Center / SAM placeholders (prefer Azure Key Vault in production) ---
PARTNER_CENTER_APP_ID=
PARTNER_CENTER_ACCOUNT_ID=
# PARTNER_CENTER_MODE=sandbox

# --- Signed webhooks (optional) ---
# HMAC SHA-256 of the raw body in x-webhook-signature: sha256=<hex>
WEBHOOK_SECRET=
# WEBHOOK_CLIENT_STATE=

# --- Smoke tests (optional) ---
# SMOKE_BASE=http://localhost:3000
