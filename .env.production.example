# =============================================================================
# Production — netrichtechnologies Microsoft 365 Control Panel
# Copy to .env.production (never commit secrets).
# Domain: https://office365.cp.netrichtechnologies.com
# Deploy: npm run deploy:check && npm run deploy:docker
# =============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- App ---
NEXT_PUBLIC_APP_URL=https://office365.cp.netrichtechnologies.com
NEXT_PUBLIC_APP_DOMAIN=office365.cp.netrichtechnologies.com

# --- Microsoft Entra ID (required for production SSO) ---
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_AUTHORITY=https://login.microsoftonline.com/common
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- NestJS CSP API (optional — UI falls back to .data if unreachable) ---
# Browser must not talk to Nest directly. Next.js proxies /api/csp after session auth.
NEXT_PUBLIC_CSP_API_URL=https://api.office365.cp.netrichtechnologies.com
CSP_API_URL=http://csp-api:8080
# Shared secret between Next and Nest (≥16 chars). Generate: npm run deploy:secret
CSP_INTERNAL_API_SECRET=

# --- Session (REQUIRED — ≥32 chars). Generate: npm run deploy:secret ---
PORTAL_SESSION_SECRET=

# --- Demo login — keep OFF in real production ---
ALLOW_DEMO_LOGIN=false
DEMO_LOGIN_PASSWORD=

# Trust X-Forwarded-For for login rate limits (set when behind nginx / a load balancer).
TRUST_PROXY=true

# --- Partner Center / SAM ---
PARTNER_CENTER_APP_ID=
PARTNER_CENTER_ACCOUNT_ID=
PARTNER_CENTER_MODE=sandbox

# --- Docker backend profile (only if using --with-backend) ---
# POSTGRES_USER=netrich
# POSTGRES_PASSWORD=
# POSTGRES_DB=netrich_csp
# DATABASE_URL=postgresql://netrich:CHANGE_ME@postgres:5432/netrich_csp?schema=public
# REDIS_URL=redis://redis:6379
# CORS_ORIGINS=https://office365.cp.netrichtechnologies.com
# AZURE_AD_API_AUDIENCE=
# HOST_PORT=3000
# API_HOST_PORT=8080
