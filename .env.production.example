# =============================================================================
# Production — netrichtechnologies Microsoft 365 Control Panel
# Copy to .env.production (never commit secrets).
# Domain: https://office365.cp.netrichtechnologies.com
# Native runbook (no Docker): docs/DEPLOYMENT.md
#   npm run deploy:check && npm run deploy:build
# =============================================================================

NODE_ENV=production
PORT=3000
# Bind to loopback; IIS/Nginx on this host proxies :443 → :3000
HOSTNAME=127.0.0.1

# --- App ---
NEXT_PUBLIC_APP_URL=https://office365.cp.netrichtechnologies.com
NEXT_PUBLIC_APP_DOMAIN=office365.cp.netrichtechnologies.com

# --- Microsoft Entra ID (required for production SSO) ---
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_AUTHORITY=https://login.microsoftonline.com/common
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
AZURE_AD_API_AUDIENCE=

# --- NestJS CSP API (required in production — no JSON fallback) ---
# Browser must not talk to Nest directly. Next.js proxies /api/csp after session auth.
# Do not set NEXT_PUBLIC_CSP_API_URL — that would expose Nest to the browser bundle.
# Native host: Nest listens on loopback. Do not use Docker DNS names (csp-api, postgres, redis).
CSP_API_URL=http://127.0.0.1:8080
# Shared secret between Next and Nest (≥16 chars). Generate: npm run deploy:secret
CSP_INTERNAL_API_SECRET=

# --- Session (REQUIRED — ≥32 chars). Generate: npm run deploy:secret ---
PORTAL_SESSION_SECRET=

# Everyday sign-in is Microsoft Entra ID. Optional first-user bootstrap (no default mailbox).
# Must NOT be admin@netrichtechnologies.com
# PORTAL_BOOTSTRAP_ADMIN_EMAIL=

# Trust X-Real-IP for login rate limits (set when behind nginx / IIS).
TRUST_PROXY=true

# --- Partner Center / SAM (live tokens belong in backend/.env) ---
PARTNER_CENTER_APP_ID=
PARTNER_CENTER_ACCOUNT_ID=
PARTNER_CENTER_MODE=sandbox

# --- Signed webhooks (optional) ---
# WEBHOOK_SECRET=
# WEBHOOK_CLIENT_STATE=
